node_modules/
coverage/
*.tsbuildinfo
**/.remember

# Stryker mutation testing scratch dir (never commit)
.stryker-tmp/

# Stryker HTML/JSON report — regenerated by every `npm run mutation` run, so a
# committed copy is instant churn and is stale the moment anyone re-runs it.
# The score that matters is the CI gate's (mutation.yml); read a local run from
# reports/mutation/mutation.html in your working tree, don't version it.
reports/

# Build output — produced by CI (release workflow) or by `npm run build`
# locally / from install.sh. Never committed; see CLAUDE.md "Build artifacts".
dist/
