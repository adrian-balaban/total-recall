@startuml fitness
skinparam shadowing false
skinparam defaultFontName Helvetica
title Where the ADL assertions are checked

rectangle "structure · runtime-safety\ndata-governance · code-quality" as a1
rectangle "contracts.adl\nMCP tools, hook envelope, memory file" as a2
rectangle "workflows.adl\nshutdown, org-sync sagas" as a3
rectangle "capabilities.adl" as a4
rectangle "system.adl" as a5
rectangle "architecture-style.adl" as a6

rectangle "fitness.test.ts (ArchUnitTS)\n+ behavioural tests\nfile sets: components.ts" as t1
rectangle "schema-parity, boundary,\nredaction, hook tests" as t2
rectangle "atomic-write, shutdown,\norg-sync, bulk tests" as t3
rectangle "rerank, session-history,\nread-only-flush tests" as t4
rectangle "adl-consistency.test.ts" as t5
rectangle "indexed only" as t6

a1 --> t1
a2 --> t2
a3 --> t3
a4 --> t4
a5 --> t5
a6 ..> t6
@enduml
