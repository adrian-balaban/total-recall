DESCRIPTION Allowed dependencies between the Total Recall modules (the C3 module map as rules)
CATEGORY Static Coupling
NAMESPACE TrStructureNS
DEFINE SYSTEM Total Recall AS tr
    DEFINE COMPONENT Pure Helpers AS helpers
    DEFINE COMPONENT State AS state
    DEFINE COMPONENT Paths AS paths
    DEFINE COMPONENT Persistence AS persistence
    DEFINE COMPONENT Search AS search
    DEFINE COMPONENT Vectors AS vectors
    DEFINE COMPONENT Tool Registry AS registry
    DEFINE COMPONENT Tools AS tools
    DEFINE COMPONENT Server AS server
    DEFINE COMPONENT Spec AS spec

# Pure helpers are leaves: also bundled standalone for the hooks (frontmatter, privacy-filter)
ASSERT(Pure Helpers have no dependency on any other component) # [TR-S1]
# The spec parsers, config and field sanitiser are pure helpers too (src/spec/{config,fields,elements,adl-parse})

# Layering
ASSERT(State, Persistence, Search and Vectors have no dependency on Tools) # [TR-S2]
ASSERT(No component depends on Server) # [TR-S3]
ASSERT(No production code depends on test code) # [TR-S4]

# Each tool owns its schema, handler and register(); only the registry is shared
ASSERT(Each of the store, mutate, query, recall and rerank tools has no dependency on any other tool except Tool Registry) # [TR-S5]
# Paths is only for redactPaths(), so a tool error never leaks the user's home layout
ASSERT(Tool Registry depends only on State and Paths) # [TR-S6]
ASSERT(Spec has no dependency on Tools) # [TR-S8]

ASSERT(Total Recall has no circular dependencies) # [TR-S7]
ASSERT(State has no dependency on any other component) # [TR-S9]

# Lexical search works without the optional vector stack and without the persistence layer
ASSERT(Search has no dependency on Vectors or Persistence) # [TR-S10]
# S5 covers the five isolated tools; bulk and architecture reuse store and mutate on purpose
ASSERT(The bulk and architecture tools depend on no tool other than store, mutate and Tool Registry) # [TR-S11]
