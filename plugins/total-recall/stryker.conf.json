{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "reporters": ["clear-text", "html", "progress"],
  "concurrency": 2,
  "timeoutMS": 60000,
  "disableTypeChecks": true,
  "mutate": [
    "src/ebbinghaus.ts",
    "src/tfidf.ts",
    "src/rrf.ts",
    "src/persistence.ts",
    "src/vectorStore.ts",
    "src/dates.ts",
    "src/frontmatter.ts",
    "src/lru-cache.ts",
    "src/paths.ts",
    "src/auto-reconcile.ts",
    "src/journal.ts",
    "src/vault-scan.ts",
    "src/state.ts",
    "src/embeddings.ts",
    "src/errors.ts",
    "src/types.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 65
  }
}